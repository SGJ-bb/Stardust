# 图标批量生成工具配置
# 复制此文件为 .env 并填入你的实际值

# ========== 图片生成 API 配置 ==========
# 国内中转 API（兼容 OpenAI 格式）
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=dall-e-3  # 或 gpt-image-1 / stable-diffusion-xl 等

# 图片尺寸: 1024x1024 / 1792x1024 / 1024x1792 (取决于模型支持)
IMAGE_SIZE=1024x1024

# 图片质量: standard / high (DALL-E 3 支持)
IMAGE_QUALITY=standard

# 风格: vivid / natural (DALL-E 3 支持)
IMAGE_STYLE=vivid

# ========== 输出目录 ==========
OUTPUT_DIR=./generated_icons
PNG_SUBDIR=png
SVG_SUBDIR=svg

# ========== SVG 转换配置 ==========
# 可选: vtracer / potrace / none (需要 pip install vtracer 或系统安装 potrace)
SVG_CONVERTER=none

# ========== 并发与重试 ==========
# 并发请求数 (建议 1-3，避免触发限流)
CONCURRENCY=2
# 单图最大重试次数
MAX_RETRIES=3
# 重试间隔秒数
RETRY_DELAY=5

# ========== 代理设置 (可选) ==========
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
