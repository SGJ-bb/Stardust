<!--
    avd_mood_angry_vector.xml — 怒气符号矢量图（anim_mood_angry 的 drawable 源）
    包含：膨胀的红粉色圆 + 锯齿形外框 + 向上的蒸汽线条 + 感叹号
    viewport: 28x32, 主体圆心在 (14, 20)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="32dp"
    android:viewportWidth="28"
    android:viewportHeight="32">

    <!-- ===== 整体组（用于抖动） ===== -->
    <group android:name="angry_group"
        android:pivotX="14"
        android:pivotY="18">

        <!-- ===== 蒸汽/怒气线条 (在圆上方) ===== -->
        <!-- 蒸汽线1 (左侧) -->
        <group android:name="steam1"
            android:pivotX="9"
            android:pivotY="6">
            <path
                android:name="steam1_path"
                android:pathData="M7,8 Q6,5 8,3 Q10,5 9,8"
                android:strokeColor="#aaaaaa"
                android:strokeWidth="1.2"
                android:strokeLineCap="round"
                android:fillColor="@android:color/transparent"/>
        </group>

        <!-- 蒸汽线2 (中间) -->
        <group android:name="steam2"
            android:pivotX="14"
            android:pivotY="4">
            <path
                android:name="steam2_path"
                android:pathData="M14,7 Q13,3 15,0 Q17,3 14,7"
                android:strokeColor="#999999"
                android:strokeWidth="1.4"
                android:strokeLineCap="round"
                android:fillColor="@android:color/transparent"/>
        </group>

        <!-- 蒸汽线3 (右侧) -->
        <group android:name="steam3"
            android:pivotX="19"
            android:pivotY="6">
            <path
                android:name="steam3_path"
                android:pathData="M19,8 Q20,5 18,3 Q16,5 19,8"
                android:strokeColor="#aaaaaa"
                android:strokeWidth="1.2"
                android:strokeLineCap="round"
                android:fillColor="@android:color/transparent"/>
        </group>

        <!-- ===== 锯齿形爆炸外框 ===== -->
        <path
            android:name="anger_burst"
            android:pathData="
                M14,8
                L16,11 L19,9 L18,12 L22,12 L19,14 L22,17
                L18,17 L19,21 L16,19 L14,23
                L12,19 L9,21 L10,17
                L6,17 L9,14 L6,12 L10,12
                L9,9 L12,11 Z"
            android:fillColor="#ff6b9d"
            android:pivotX="14"
            android:pivotY="16"/>

        <!-- ===== 内部深色圆（增加层次） ===== -->
        <path
            android:name="anger_body"
            android:pathData="M14,11 A6,6 0 1,1 14,23 A6,6 0 1,1 14,11 Z"
            android:fillColor="#ff4d7a"
            android:pivotX="14"
            android:pivotY="17"/>

        <!-- ===== 感叹号 ===== -->
        <!-- 感叹号竖线 -->
        <path
            android:name="exclaim_line"
            android:pathData="M14,13 L14,18.5"
            android:strokeColor="#ffffff"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

        <!-- 感叹号点 -->
        <path
            android:name="exclaim_dot"
            android:pathData="M14,21 A1,1 0 1,1 14,23 A1,1 0 1,1 14,21 Z"
            android:fillColor="#ffffff"/>

        <!-- ===== 愤怒眉毛 (斜向内) ===== -->
        <path
            android:name="brow_left"
            android:pathData="M10,14 L13,15.5"
            android:strokeColor="#cc3366"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

        <path
            android:name="brow_right"
            android:pathData="M18,14 L15,15.5"
            android:strokeColor="#cc3366"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>

    </group>
</vector>
