<?xml version="1.0" encoding="utf-8"?>
<!--
    星尘设计系统 - 样式定义
    基于 Impeccable 排版/空间/交互设计原则
    核心原则：语义化命名、层级清晰、避免重复
-->
<resources>

    <!-- ===== 排版系统 (Impeccable Typography) ===== -->
    <!-- 模块化缩放比例 1.25，基准 14sp -->

    <!-- Display - 大标题，仅用于空状态/引导页 -->
    <style name="TextAppearance.Stardust.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- Headline - 页面标题 -->
    <style name="TextAppearance.Stardust.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Title - 区块标题 -->
    <style name="TextAppearance.Stardust.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Body - 正文 -->
    <style name="TextAppearance.Stardust.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- Body Secondary - 次要正文 -->
    <style name="TextAppearance.Stardust.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- Caption - 辅助文字 -->
    <style name="TextAppearance.Stardust.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- Overline - 标签/分类 -->
    <style name="TextAppearance.Stardust.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- 聊天消息专用 -->
    <style name="TextAppearance.Stardust.ChatMessage" parent="TextAppearance.Stardust.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.Stardust.ChatTime" parent="TextAppearance.Stardust.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- 工具栏标题 -->
    <style name="TextAppearance.Stardust.ToolbarTitle" parent="TextAppearance.Stardust.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ===== 按钮样式 ===== -->

    <!-- 主按钮 - 渐变药丸 -->
    <style name="Widget.Stardust.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_h</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次按钮 - 描边药丸 -->
    <style name="Widget.Stardust.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_h</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <!-- 图标按钮 -->
    <style name="Widget.Stardust.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:minWidth">@dimen/icon_button_size</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
        <item name="android:padding">0dp</item>
        <item name="iconTint">@color/accent_purple</item>
        <item name="iconSize">@dimen/button_icon_size</item>
    </style>

    <!-- 发送按钮 -->
    <style name="Widget.Stardust.Button.Send" parent="Widget.Material3.Button.IconButton">
        <item name="android:background">@drawable/bg_send_button</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- ===== 卡片样式 ===== -->

    <!-- 标准卡片 -->
    <style name="Widget.Stardust.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- 渐变卡片 -->
    <style name="Widget.Stardust.Card.Gradient" parent="Widget.Stardust.Card">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="android:background">@drawable/bg_card_gradient</item>
    </style>

    <!-- ===== 输入框样式 ===== -->

    <style name="Widget.Stardust.EditText" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingHorizontal">@dimen/input_padding_h</item>
        <item name="android:paddingVertical">@dimen/input_padding_v</item>
        <item name="android:minHeight">@dimen/input_height</item>
    </style>

    <!-- 聊天输入框 -->
    <style name="Widget.Stardust.EditText.Chat" parent="Widget.Stardust.EditText">
        <item name="android:background">@drawable/bg_edittext_rounded</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ===== Chip 样式 ===== -->

    <style name="Widget.Stardust.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:background">@drawable/bg_prediction_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="chipStrokeColor">@color/stroke_subtle</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/chip_radius</item>
    </style>

    <!-- ===== 进度条样式 ===== -->

    <style name="Widget.Stardust.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:progressDrawable">@drawable/affection_progress</item>
        <item name="android:minHeight">@dimen/progress_height</item>
        <item name="android:maxHeight">@dimen/progress_height</item>
    </style>

    <!-- ===== 对话框样式 ===== -->

    <style name="Widget.Stardust.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Stardust.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Stardust.Button.Secondary</item>
    </style>

    <!-- ===== BottomSheet 样式 ===== -->

    <style name="Widget.Stardust.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Stardust.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Stardust.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/space_7</item>
        <item name="cornerSizeTopRight">@dimen/space_7</item>
    </style>

    <!-- ===== 布局便捷样式别名 ===== -->

    <!-- 区块标题 (用于设置页/编辑页的分组标题) -->
    <style name="Stardust.SectionTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_accent</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:layout_marginBottom">@dimen/space_2</item>
    </style>

    <!-- 标准卡片 -->
    <style name="Stardust.Card.Standard" parent="Widget.Stardust.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- 标准输入框 (Material3 OutlinedBox) -->
    <style name="Stardust.Input.Standard" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxStrokeColor">@color/stroke_subtle</item>
        <item name="hintTextColor">@color/brand_accent</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <!-- 主按钮别名 -->
    <style name="Stardust.Button.Primary" parent="Widget.Stardust.Button.Primary" />

    <!-- 次按钮别名 -->
    <style name="Stardust.Button.Secondary" parent="Widget.Stardust.Button.Secondary" />

</resources>
