<!-- 轨道环绕加载动画 - 3个同心圆环以不同速度和方向旋转，形成行星轨道效果 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/avd_loading_orbit_vector">
    <target android:name="orbit_outer">
        <aapt:attr xmlns:aapt="http://schemas.android.com/apt" name="animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="3000"
                android:interpolator="@android:anim/linear_interpolator"
                android:repeatCount="infinite"
                android:repeatMode="restart" />
        </aapt:attr>
    </target>
    <target android:name="orbit_middle">
        <aapt:attr xmlns:aapt="http://schemas.android.com/apk/res/android" name="animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="360"
                android:valueTo="0"
                android:duration="2000"
                android:interpolator="@android:anim/linear_interpolator"
                android:repeatCount="infinite"
                android:repeatMode="restart" />
        </aapt:attr>
    </target>
    <target android:name="orbit_inner">
        <aapt:attr xmlns:aapt="http://schemas.android.com/apk/res/android" name="animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="1.15"
                    android:duration="750"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="1.15"
                    android:duration="750"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="255"
                    android:valueTo="100"
                    android:duration="750"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>