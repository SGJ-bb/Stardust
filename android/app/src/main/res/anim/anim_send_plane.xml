<!-- 发送纸飞机动画 - 点击发送按钮时从左下飞向右上消失 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/avd_send_plane_vector">
    <target android:name="plane_group">
        <aapt:attr xmlns:aapt="http://schemas.android.com/apk/res/android" name="animation">
            <set>
                <!-- 平移动画：从左下飞向右上 -->
                <objectAnimator
                    android:propertyName="translateX"
                    android:valueFrom="0"
                    android:valueTo="40"
                    android:duration="500"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="-30"
                    android:duration="500"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <!-- 旋转动画：向上倾斜 -->
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="-15"
                    android:duration="500"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <!-- 后半段淡出效果（延迟250ms启动） -->
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="255"
                    android:valueTo="0"
                    android:duration="250"
                    android:startOffset="250"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <!-- 后半段缩小效果（延迟250ms启动） -->
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.0"
                    android:valueTo="0.5"
                    android:duration="250"
                    android:startOffset="250"
                    android:interpolator="@android:anim/accelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="0.5"
                    android:duration="250"
                    android:startOffset="250"
                    android:interpolator="@android:anim/accelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>