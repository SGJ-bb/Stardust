<?xml version="1.0" encoding="utf-8"?>
<!--
    酒馆角色卡导入预览弹窗
    使用 AlertDialog + setView() 方式展示
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="@dimen/space_4">

    <!-- 标题栏 -->
    <TextView
        style="@style/Stardust.SectionTitle"
        android:text="🎭 角色卡预览"
        android:layout_marginBottom="@dimen/space_3" />

    <!-- 头像 + 基本信息 行 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_3">

        <ImageView
            android:id="@+id/iv_tavern_avatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_circle_avatar_placeholder" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_3">

            <TextView
                android:id="@+id/tv_tavern_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_tavern_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_tavern_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/brand_accent"
                android:layout_marginTop="2dp"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 字段映射预览 (ScrollView) -->
    <ScrollView
        android:id="@+id/scroll_field_mapping"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp"
        android:maxHeight="300dp"
        android:background="@color/bg_elevated"
        android:padding="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_3">

        <LinearLayout
            android:id="@+id/container_field_mapping"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <!-- 带 UI 卡片的警告提示 (默认 GONE) -->
    <LinearLayout
        android:id="@+id/layout_ui_warning"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_accent_container"
        android:padding="@dimen/space_2"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/space_3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ 此角色卡包含自定义 UI 元素"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UI 元素仅作预览参考，不会在聊天中渲染交互"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 按钮 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_import"
            style="@style/Stardust.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_2"
            android:text="取消" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_import"
            style="@style/Stardust.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="确认导入" />
    </LinearLayout>
</LinearLayout>
