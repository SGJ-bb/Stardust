<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_base">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_primary"
        android:elevation="@dimen/elevation_medium"
        app:title="角色人格设定"
        app:titleTextColor="@color/text_on_accent"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <!-- 角色基本信息 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="角色基本信息" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="角色名称">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="角色描述（简短）"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="第一句打招呼"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 对你的称呼 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="对你的称呼" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="AI要怎么称呼你？（留空则自动发现）">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_nickname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="留空时，AI会在聊天中观察你的性格，慢慢总结出一个专属称呼"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption"
                        android:lineSpacingExtra="@dimen/space_1"
                        android:layout_marginTop="@dimen/space_2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI发现的称呼"
                        android:textColor="@color/brand_accent"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_4"
                        android:visibility="gone"
                        android:id="@+id/tv_discovered_label" />

                    <LinearLayout
                        android:id="@+id/container_discovered_nicknames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 用户设定 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="用户设定" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="用户身份（如：学生、勇者、旅行者、主人...）">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_identity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="用户能力/特征（如：会魔法、擅长做饭、温柔...）"
                        android:layout_marginTop="@dimen/space_3">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_abilities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 性格特征 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="性格特征" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_2">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="性格随剧情进化"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold"
                            android:textColor="@color/brand_accent" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_personality_evolution"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每上升5点好感度，AI会根据剧情发展和角色设定自动重写性格，让角色随着互动逐渐成长变化"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption"
                        android:lineSpacingExtra="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="性格描述"
                        android:layout_marginTop="@dimen/space_3">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_personality"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="说话风格"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_speech_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="口头禅/常用语（每行一句）"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_catchphrases"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 外观特征 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="外观特征" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="外貌描述">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_appearance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="喜好/讨厌"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_persona_preferences"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 世界书设定 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="世界书设定（背景设定）" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="世界观/背景设定">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_world_setting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="与用户的关系设定"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_world_relationship"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="特殊规则/注意事项"
                        android:layout_marginTop="@dimen/space_2">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_world_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 自由模式设定 -->
            <TextView
                style="@style/Stardust.SectionTitle"
                android:text="自由模式（完整指令）"
                android:layout_marginTop="@dimen/space_2" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stardust.Card.Standard"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="将性格、名字、性别、世界观等所有设定一股脑写在这里，适合喜欢自由撰写的用户。填写后优先使用此模式。"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption"
                        android:lineSpacingExtra="@dimen/space_1"
                        android:layout_marginBottom="@dimen/space_2" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Stardust.Input.Standard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="在此输入完整的角色设定指令...">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_free_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="6"
                            android:gravity="top"
                            android:maxLines="20" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 操作按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_persona"
                style="@style/Stardust.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginBottom="@dimen/space_4"
                android:text="保存设定" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_persona"
                style="@style/Stardust.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="恢复默认（星尘）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_tavern"
                style="@style/Stardust.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="🎭 导入酒馆角色卡 (SillyTavern)" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
