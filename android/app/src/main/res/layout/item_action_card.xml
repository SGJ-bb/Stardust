<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#161b22"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_action_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待机"
                android:textSize="13sp"
                android:textColor="#e5e7eb"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_action_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="loop · 125ms/帧"
                android:textSize="11sp"
                android:textColor="#6b7280" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_frame_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/4 帧"
            android:textSize="11sp"
            android:textColor="#22c55e"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="#22c55e20"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_edit_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="编辑"
            android:textSize="11sp"
            android:textColor="#667eea"
            android:minWidth="48dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_generate_frames"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="生成帧图"
            android:textSize="11sp"
            android:textColor="#22c55e"
            android:minWidth="64dp"
            android:minHeight="0dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
