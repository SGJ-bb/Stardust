<?xml version="1.0" encoding="utf-8"?>
<!--
    星尘设计系统 - 主界面布局
    基于 Impeccable 8pt 网格 + 语义化间距/尺寸引用
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_chat_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_gradient"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ui_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:clickable="false"
        android:focusable="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@drawable/bg_toolbar_glass"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="0dp"
            android:paddingStart="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:titleTextColor="@color/text_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iv_ai_avatar_small_card"
                    android:layout_width="@dimen/avatar_medium"
                    android:layout_height="@dimen/avatar_medium"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_marginEnd="@dimen/space_3"
                    app:cardCornerRadius="@dimen/avatar_medium"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_end"
                    app:strokeWidth="@dimen/avatar_border"
                    app:strokeColor="@color/accent_blue">

                    <ImageView
                        android:id="@+id/iv_ai_avatar_small"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_default_ai"
                        android:contentDescription="AI头像"
                        android:clickable="true"
                        android:focusable="true" />
                </com.google.android.material.card.MaterialCardView>

                <ImageButton
                    android:id="@+id/btn_more"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_more"
                    android:contentDescription="更多"
                    android:scaleType="centerInside"
                    android:padding="@dimen/space_3"
                    app:tint="@color/accent_purple" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_marginEnd="@dimen/space_2">

                    <TextView
                        android:id="@+id/tv_pet_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/TextAppearance.Stardust.Title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_days_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="第1天"
                            style="@style/TextAppearance.Stardust.Overline"
                            android:textColor="@color/accent_purple"
                            android:textSize="9sp" />

                        <ProgressBar
                            android:id="@+id/progress_affection"
                            style="@style/Widget.Stardust.ProgressBar"
                            android:layout_width="36dp"
                            android:layout_height="@dimen/progress_height"
                            android:layout_marginStart="@dimen/space_1"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="@color/accent_pink"
                            android:progressBackgroundTint="@color/white_alpha_20" />

                        <TextView
                            android:id="@+id/tv_affection_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            style="@style/TextAppearance.Stardust.Overline"
                            android:textColor="@color/accent_pink"
                            android:textSize="8sp"
                            android:layout_marginStart="@dimen/space_1"
                            android:ellipsize="end"
                            android:maxEms="6"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ 25°"
                    style="@style/TextAppearance.Stardust.Caption"
                    android:textColor="@color/text_link"
                    android:textSize="11sp"
                    android:layout_marginEnd="@dimen/space_2"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:layout_marginEnd="@dimen/space_1">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btn_moments"
                            android:layout_width="@dimen/icon_button_size"
                            android:layout_height="@dimen/icon_button_size"
                            android:background="@drawable/bg_icon_button"
                            android:src="@drawable/ic_diary"
                            android:contentDescription="动态"
                            android:scaleType="centerInside"
                            android:padding="@dimen/space_2"
                            android:layout_marginEnd="@dimen/space_1"
                            app:tint="@color/text_secondary" />

                        <ImageButton
                            android:id="@+id/btn_calendar"
                            android:layout_width="@dimen/icon_button_size"
                            android:layout_height="@dimen/icon_button_size"
                            android:background="@drawable/bg_icon_button"
                            android:src="@drawable/ic_diary"
                            android:contentDescription="日历"
                            android:scaleType="centerInside"
                            android:padding="@dimen/space_2"
                            android:layout_marginEnd="@dimen/space_1"
                            app:tint="@color/text_secondary" />

                        <ImageButton
                            android:id="@+id/btn_album"
                            android:layout_width="@dimen/icon_button_size"
                            android:layout_height="@dimen/icon_button_size"
                            android:background="@drawable/bg_icon_button"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:contentDescription="纪念相册"
                            android:scaleType="centerInside"
                            android:padding="@dimen/space_2"
                            android:layout_marginEnd="@dimen/space_1"
                            app:tint="@color/text_secondary" />

                        <ImageButton
                            android:id="@+id/btn_diary"
                            android:layout_width="@dimen/icon_button_size"
                            android:layout_height="@dimen/icon_button_size"
                            android:background="@drawable/bg_icon_button"
                            android:src="@drawable/ic_diary"
                            android:contentDescription="日记"
                            android:scaleType="centerInside"
                            android:padding="@dimen/space_2"
                            android:layout_marginEnd="@dimen/space_1"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="设置"
                    android:scaleType="centerInside"
                    android:padding="@dimen/space_2"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_marginEnd="@dimen/space_1"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/toolbar_height"
            android:layout_marginBottom="@dimen/bottom_bar_height"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_10"
            android:clipToPadding="false" />

        <ViewStub
            android:id="@+id/view_stub_live2d"
            android:layout="@layout/stub_live2d"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/bottom_bar_height" />

        <LinearLayout
            android:id="@+id/layout_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:elevation="8dp">

            <HorizontalScrollView
                android:id="@+id/scroll_predictions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_end"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:paddingTop="@dimen/space_2"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_predictions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/layout_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_3"
                android:background="@drawable/bg_input_bar_glass"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/text_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="发消息给TA..."
                app:boxCornerRadiusTopStart="@dimen/input_radius"
                app:boxCornerRadiusTopEnd="@dimen/input_radius"
                app:boxCornerRadiusBottomStart="@dimen/input_radius"
                app:boxCornerRadiusBottomEnd="@dimen/input_radius"
                app:boxBackgroundColor="@color/surface_input"
                app:hintTextColor="@color/text_muted"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:inputType="textMultiLine"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btn_image_upload"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerInside"
                android:padding="@dimen/space_3"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="上传图片" />

            <ImageButton
                android:id="@+id/btn_sticker_chat"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:src="@drawable/ic_sticker"
                android:scaleType="centerInside"
                android:padding="@dimen/space_3"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="表情包" />

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:src="@drawable/ic_voice"
                android:scaleType="centerInside"
                android:padding="@dimen/space_3"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="语音" />

            <ImageButton
                android:id="@+id/btn_phone_call"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:src="@drawable/ic_phone_call"
                android:scaleType="centerInside"
                android:padding="@dimen/space_3"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="语音通话" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:src="@drawable/ic_send"
                android:scaleType="centerInside"
                android:padding="@dimen/space_3"
                android:layout_marginStart="@dimen/space_1"
                android:background="@drawable/bg_send_button"
                app:tint="@color/text_on_accent"
                android:contentDescription="发送" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
