<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_chat_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_gradient"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ui_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:clickable="false"
        android:focusable="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/color_toolbar_bg"
            android:clickable="true"
            android:focusable="true"
            app:titleTextColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iv_ai_avatar_small_card"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_end"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/accent_blue">

                    <ImageView
                        android:id="@+id/iv_ai_avatar_small"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_default_ai"
                        android:contentDescription="AI头像"
                        android:clickable="true"
                        android:focusable="true" />
                </com.google.android.material.card.MaterialCardView>

                <ImageButton
                    android:id="@+id/btn_more"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_more"
                    android:contentDescription="更多"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    app:tint="@color/accent_purple" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tv_pet_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_days_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="第1天"
                            android:textColor="@color/accent_purple"
                            android:textSize="9sp" />

                        <ProgressBar
                            android:id="@+id/progress_affection"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="36dp"
                            android:layout_height="2.5dp"
                            android:layout_marginStart="3dp"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="@color/accent_pink"
                            android:progressBackgroundTint="@color/color_white_alpha_20" />

                        <TextView
                            android:id="@+id/tv_affection_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/accent_pink"
                            android:textSize="8sp"
                            android:layout_marginStart="3dp"
                            android:ellipsize="end"
                            android:maxEms="6"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ 25°"
                    android:textColor="@color/color_text_link"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/btn_moments"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_button"
                            android:src="@drawable/ic_diary"
                            android:contentDescription="动态"
                            android:scaleType="centerInside"
                            android:padding="7dp"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/color_text_chat_secondary" />

                        <ImageButton
                            android:id="@+id/btn_calendar"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_button"
                            android:src="@drawable/ic_diary"
                            android:contentDescription="日历"
                            android:scaleType="centerInside"
                            android:padding="7dp"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/color_text_chat_secondary" />

                        <ImageButton
                            android:id="@+id/btn_album"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_button"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:contentDescription="纪念相册"
                            android:scaleType="centerInside"
                            android:padding="7dp"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/color_text_chat_secondary" />

                        <ImageButton
                            android:id="@+id/btn_diary"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_button"
                            android:src="@drawable/ic_diary"
                            android:contentDescription="日记"
                            android:scaleType="centerInside"
                            android:padding="7dp"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/color_text_chat_secondary" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/btn_persona_switch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_avatar_default_ai"
                    android:contentDescription="切换角色"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:layout_marginStart="4dp"
                    app:tint="@color/color_text_chat_secondary" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="设置"
                    android:scaleType="centerInside"
                    android:padding="7dp"
                    android:layout_marginStart="4dp"
                    app:tint="@color/color_text_chat_secondary" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="68dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="48dp"
            android:clipToPadding="false" />

        <ViewStub
            android:id="@+id/view_stub_live2d"
            android:layout="@layout/stub_live2d"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="68dp" />

        <LinearLayout
            android:id="@+id/layout_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:elevation="0dp">

            <HorizontalScrollView
                android:id="@+id/scroll_predictions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_end"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_predictions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/layout_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:background="@color/color_card_dark_alpha"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/text_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="发消息给星尘..."
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxBackgroundColor="@color/color_input_bg_variant"
                app:hintTextColor="@color/color_text_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:inputType="textMultiLine"
                    android:textColor="@color/color_text_chat_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btn_image_upload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="上传图片" />

            <ImageButton
                android:id="@+id/btn_sticker_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sticker"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="表情包" />

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_voice"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="语音" />

            <ImageButton
                android:id="@+id/btn_phone_call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_phone_call"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/accent_purple"
                android:contentDescription="语音通话" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_send"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_send_button"
                app:tint="#ffffff"
                android:contentDescription="发送" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
