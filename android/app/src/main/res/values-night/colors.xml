    <color name="color_main_bg_alpha">#b316162a</color>
    <color name="color_input_bg_variant">#1e1e3a</color>
    <color name="color_toolbar_bg">#16162a</color>
    <color name="color_text_gray">#9098b0</color>              <!-- [修复] 原#7a80a0对比度不足 -->
    <color name="color_text_disabled">#4a5070</color>
    <color name="color_text_light_gray">#e8e8e8</color>
